{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Krea 2 Turbo (stock)"},
        "inputs": {"unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen3-VL 4B bf16 (type krea2)"},
        "inputs": {"clip_name": "qwen3vl_4b_bf16.safetensors", "type": "krea2", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "Qwen-Image VAE"},
        "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "4": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "STYLE A: QPixel V2 (0 = off)"},
        "inputs": {"model": ["1", 0], "lora_name": "qpixel_v2_krea2.safetensors", "strength_model": 0.0}},
  "5": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "STYLE B: 90s Flat Cartoon (0 = off)"},
        "inputs": {"model": ["4", 0], "lora_name": "90s_flat_cartoon_krea2.safetensors", "strength_model": 0.0}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "PROMPT"},
        "inputs": {"clip": ["2", 0], "text": ""}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "NEGATIVE (inert at CFG 1)"},
        "inputs": {"clip": ["2", 0], "text": ""}},
  "8": {"class_type": "EmptyLatentImage", "_meta": {"title": "1024 square (sprite sheet canvas)"},
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "9": {"class_type": "KSampler", "_meta": {"title": "Turbo: 14 steps / CFG 1 / euler_ancestral / beta"},
        "inputs": {"model": ["5", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["8", 0],
                   "seed": 90, "steps": 14, "cfg": 1.0,
                   "sampler_name": "euler_ancestral", "scheduler": "beta", "denoise": 1.0}},
  "10": {"class_type": "VAEDecode", "inputs": {"samples": ["9", 0], "vae": ["3", 0]}},
  "11": {"class_type": "SaveImage", "_meta": {"title": "Save"},
         "inputs": {"images": ["10", 0], "filename_prefix": "pyxel90s/sprite"}}
}
